<!--
    MotionTokens.xaml — drop-in house design-token system for Uno Platform / WinUI.
    Canonical values from the xaml-design-polish skill (CSS source of truth, translated to XAML).

    HOW TO USE
      1. Drop this file under /Themes (or anywhere) in your Single Project.
      2. Merge it in App.xaml:
             <ResourceDictionary.MergedDictionaries>
                 <ResourceDictionary Source="ms-appx:///Themes/MotionTokens.xaml" />
             </ResourceDictionary.MergedDictionaries>
      3. The ShadowCollection/Shadow resources (ShadowContainer) are NOT covered by
         UnoFeatures: Toolkit. ShadowContainer ships in the separate Uno.Toolkit.Skia.WinUI
         package, which you must reference explicitly:
             <!-- csproj -->
             <ItemGroup>
               <PackageReference Include="Uno.Toolkit.Skia.WinUI" />
             </ItemGroup>
         If your app uses Central Package Management (the default unoapp scaffold does),
         also add the version to Directory.Packages.props (match your Toolkit version):
             <PackageVersion Include="Uno.Toolkit.Skia.WinUI" Version="8.4.2" />
         WARNING: because this file is a MERGED dictionary, a missing Skia.WinUI reference
         does not fail gracefully — the unresolved utu:ShadowCollection type
         (UXAML0001: type ShadowCollection could not be found) aborts the WHOLE dictionary
         at build, taking easing/radius/duration tokens down with it. Verified on
         Uno.Sdk 6.5.36 / Toolkit 8.4.2.
         If you do NOT want shadows, delete the SHADOWS section AND the utu xmlns above,
         and you can skip the Uno.Toolkit.Skia.WinUI reference entirely.

    These are ADDITIVE to Material. Keep using Material color/type-scale resources for
    colors and fonts (no hardcoded hex / font sizes); these tokens add easing, duration,
    radius, and the layered-shadow stacks Material does not provide.

    NOTE ON DURATIONS: <Duration> as a keyed resource parses in WinUI/Uno's XAML, but if a
    given Uno.Sdk version rejects it, use the *Ms x:Double values below in code-behind /
    Composition (TimeSpan.FromMilliseconds) and inline the Storyboard Duration instead.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:utu="using:Uno.Toolkit.UI">

    <!-- ============================================================ -->
    <!-- EASING  (Rule 1) — KeySpline control points ARE the bezier handles. -->
    <!--   Use on <SplineDoubleKeyFrame KeySpline="{StaticResource ...}" /> -->
    <!--   For Composition, mirror with CreateCubicBezierEasingFunction (Vector2 values in comments). -->
    <!-- ============================================================ -->

    <!-- IMPORTANT: KeySpline control points must each be within [0,1] (X AND Y). Unlike CSS
         cubic-bezier, a KeySpline CANNOT overshoot — it is a timing curve clamped to the unit
         square. Overshoot must come from the animated VALUE (e.g. scale keyframes 1 -> 1.05 -> 1)
         or a Composition spring, never from the easing curve. See EaseSpring note below. -->

    <!-- cubic-bezier(0.22, 1, 0.36, 1)  — default for almost everything -->
    <KeySpline x:Key="EaseSmooth"  ControlPoint1="0.22,1"  ControlPoint2="0.36,1" />
    <!-- cubic-bezier(0.17, 1, 0.32, 1)  — decorative entrances -->
    <KeySpline x:Key="EaseOut"     ControlPoint1="0.17,1"  ControlPoint2="0.32,1" />
    <!-- cubic-bezier(0.66, 0, 0.34, 1)  — symmetric moves -->
    <KeySpline x:Key="EaseInOut"   ControlPoint1="0.66,0"  ControlPoint2="0.34,1" />

    <!-- "EaseSpring" overshoot is NOT a KeySpline (Y=1.55 is out of range and will be rejected/
         clamped). For a pop/bounce, overshoot the value instead — e.g. a Scale keyframe sequence
         1 -> 1.05 -> 1 using EaseOut on the way up and EaseSmooth settling back — or a Composition
         SpringScalarNaturalMotionAnimation (DampingRatio ~0.7, Period ~80ms) where supported on the
         target. Do not define EaseSpring as a <KeySpline>. -->
    <x:Double x:Key="SpringOvershootScale">1.05</x:Double>

    <!-- ============================================================ -->
    <!-- CORNER RADIUS  (Rule 2) -->
    <!-- ============================================================ -->
    <x:Double x:Key="RadiusSm">6</x:Double>
    <x:Double x:Key="RadiusMd">12</x:Double>
    <x:Double x:Key="RadiusLg">24</x:Double>

    <CornerRadius x:Key="RadiusSmCorner">6</CornerRadius>
    <CornerRadius x:Key="RadiusMdCorner">12</CornerRadius>
    <CornerRadius x:Key="RadiusLgCorner">24</CornerRadius>

    <!-- ============================================================ -->
    <!-- DURATION  (Rule 2 / 5 / 7) — both forms provided. -->
    <!--   *Ms doubles for Composition (TimeSpan.FromMilliseconds(150)). -->
    <!--   Duration objects for Storyboard Duration="...". -->
    <!-- ============================================================ -->
    <x:Double x:Key="DurationFastMs">150</x:Double>
    <x:Double x:Key="DurationNormalMs">200</x:Double>
    <x:Double x:Key="DurationSlowMs">280</x:Double>

    <Duration x:Key="DurationFast">0:0:0.15</Duration>
    <Duration x:Key="DurationNormal">0:0:0.2</Duration>
    <Duration x:Key="DurationSlow">0:0:0.28</Duration>

    <!-- Entrance offset (Rule 5): translateY 6px -> 0, blur 2px -> 0, opacity 0 -> 1, ~280ms EaseSmooth -->
    <x:Double x:Key="EntranceRiseOffset">6</x:Double>
    <x:Double x:Key="EntranceBlurRadius">2</x:Double>

    <!-- Tactile press scale (Rule 7): 0.98 = firm press, not a collapse -->
    <x:Double x:Key="PressScale">0.98</x:Double>

    <!-- ============================================================ -->
    <!-- SHADOWS  (Rule 6) — Uno Toolkit ShadowContainer. Layered light, hairline ring, -->
    <!--   REQUIRES the Uno.Toolkit.Skia.WinUI package (see HOW TO USE step 3) — NOT UnoFeatures:Toolkit. -->
    <!--   tiny opacities (2-8%). Apply: -->
    <!--     <utu:ShadowContainer Shadows="{StaticResource CardShadows}"> <YourCard/> </utu:ShadowContainer> -->
    <!--   Toolkit Blur renders softer than CSS blur radius — tune Blur to taste; CSS values are the start. -->
    <!--   For a crisp hairline you may prefer a 0.5px Border over the spread-only ring shadow. -->
    <!-- ============================================================ -->

    <!-- NOTE: the Toolkit Shadow blur property is BlurRadius (NOT Blur). Using Blur throws at
         dictionary load. Spread/Opacity/Color/OffsetX/OffsetY/IsInner are the other members. -->

    <!-- Everyday card: close drop + soft spread + hairline ring -->
    <utu:ShadowCollection x:Key="CardShadows">
        <utu:Shadow OffsetX="0" OffsetY="1" BlurRadius="2"  Spread="0"   Color="#000000" Opacity="0.05" />
        <utu:Shadow OffsetX="0" OffsetY="2" BlurRadius="4"  Spread="0"   Color="#000000" Opacity="0.02" />
        <utu:Shadow OffsetX="0" OffsetY="0" BlurRadius="0"  Spread="0.5" Color="#000000" Opacity="0.08" />
    </utu:ShadowCollection>

    <!-- Elevated (modals, lifted cards): same idea, more layers + light hairline ring.
         The last entry is a deliberate exception to the 2-8% rule: an opaque LIGHT ring
         (not black) standing in for a 1px border. -->
    <utu:ShadowCollection x:Key="ElevatedShadows">
        <utu:Shadow OffsetX="0" OffsetY="4" BlurRadius="8"  Spread="0"   Color="#000000" Opacity="0.02" />
        <utu:Shadow OffsetX="0" OffsetY="8" BlurRadius="12" Spread="0"   Color="#000000" Opacity="0.02" />
        <utu:Shadow OffsetX="0" OffsetY="2" BlurRadius="4"  Spread="0"   Color="#000000" Opacity="0.02" />
        <utu:Shadow OffsetX="0" OffsetY="1" BlurRadius="2"  Spread="0"   Color="#000000" Opacity="0.04" />
        <utu:Shadow OffsetX="0" OffsetY="0" BlurRadius="0"  Spread="0.5" Color="#E0E0E0" Opacity="1.0"  />
    </utu:ShadowCollection>

</ResourceDictionary>
